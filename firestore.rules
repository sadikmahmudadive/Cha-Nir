rules_version = '2';

// DRAFT security rules for Cha Nir. Review and test with the Firebase emulator before deploying.
// Principle: the browser may READ the public catalogue and a user's own data; every order,
// price, stock and discount decision is WRITTEN by trusted server code (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public storefront data
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /journal/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Wholesale price lists: visible only to approved business accounts (or public if the admin
    // switches the pricing model; in that case publish prices into /products instead).
    match /wholesalePrices/{id} {
      allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wholesale == 'approved');
      allow write: if isAdmin();
    }

    // Customers
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Customers may edit profile fields but never their own role / approval status.
      allow create: if isOwner(uid) && !('wholesale' in request.resource.data) && !('role' in request.resource.data);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wholesale', 'role']);
      allow update: if isAdmin();

      match /addresses/{addrId} { allow read, write: if isOwner(uid); }
    }

    // Orders: created by the server only (prices re-validated there). Customers read their own.
    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Public forms are written through a server route (validation + spam protection), never directly.
    match /wholesaleInquiries/{id} { allow read, write: if isAdmin(); }
    match /newsletter/{id}         { allow read, write: if isAdmin(); }
    match /discounts/{id}          { allow read, write: if isAdmin(); }
  }
}
