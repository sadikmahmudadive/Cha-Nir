rules_version = '2';

// DRAFT security rules for Cha Nir. Review and test with the Firebase emulator before deploying.
// Principle: the browser may READ the public catalogue and a user's own data; every order,
// price, stock and discount decision is WRITTEN by trusted server code (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public storefront data
    match /products/{id}   { allow read: if true; allow write: if signedIn(); }
    match /categories/{id} { allow read: if true; allow write: if signedIn(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /journal/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Wholesale price lists: visible only to approved business accounts or admin
    match /wholesalePrices/{id} {
      allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.wholesale == 'approved');
      allow write: if isAdmin();
    }

    // Customers
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) || isAdmin();

      match /addresses/{addrId} { allow read, write: if isOwner(uid) || isAdmin(); }
    }

    // Orders: customers create their order; read their own or admin reads all.
    match /orders/{id} {
      allow create: if true;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Public inquiries and newsletter subscriptions
    match /wholesaleInquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{id} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    match /discounts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
